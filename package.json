{
  "name": "three-map-terrain",
  "version": "2.2.0",
  "description": "Real-world 3D terrain and buildings for three.js from any map tiles: elevation, imagery, OpenStreetMap buildings, geolocation, and GLB / STL / USDZ export",
  "author": "whidrubeld <whidrubeld@gmail.com>",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate": "yarn typecheck && yarn lint && yarn format:check && yarn test && yarn build",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "keywords": [
    "three",
    "threejs",
    "three.js",
    "map",
    "terrain",
    "3d-map",
    "elevation",
    "dem",
    "buildings",
    "3d-buildings",
    "openstreetmap",
    "osm",
    "vector-tiles",
    "mvt",
    "gis",
    "geolocation",
    "slippy-map",
    "gltf",
    "glb",
    "stl",
    "usdz",
    "export",
    "3d-printing",
    "diorama",
    "webgpu",
    "react",
    "react-three-fiber"
  ],
  "bugs": {
    "url": "https://github.com/whidrubeld/three-map-terrain/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whidrubeld/three-map-terrain.git"
  },
  "homepage": "https://github.com/whidrubeld/three-map-terrain#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "three": ">=0.152.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
